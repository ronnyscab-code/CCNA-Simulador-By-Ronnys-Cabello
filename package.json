{
  "name": "openccna-simulator",
  "version": "1.0.0",
  "description": "A free, open-source, browser-based CCNA network simulator. No backend, no frameworks, no build step.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "author": "OpenCCNA Simulator Contributors",
  "homepage": "https://github.com/openccna/openccna-simulator",
  "repository": {
    "type": "git",
    "url": "https://github.com/openccna/openccna-simulator.git"
  },
  "keywords": [
    "ccna",
    "networking",
    "simulator",
    "cisco",
    "packet-tracer",
    "education",
    "svg",
    "canvas"
  ],
  "scripts": {
    "dev": "npx --yes serve . -l 5173",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.js",
    "build:web": "node scripts/build-web.mjs",
    "sync:android": "npm run build:web && npx cap sync android",
    "open:android": "npm run sync:android && npx cap open android",
    "assets:android": "npx capacitor-assets generate --assetPath resources --android"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
